@model IEnumerable<PcStore.Web.Models.Product>

@{
    ViewData["Title"] = "Склад";
}

<div class="admin-container">

    <!-- Заголовок -->
    <h1 class="page-title">
        <i class="bi bi-box-seam text-primary"></i> Склад
    </h1>

    <!-- Панель инструментов -->
    <div class="d-flex flex-wrap gap-3 mb-4 align-items-center justify-content-between">

        <!-- Блок фильтров и поиска -->
        <div class="d-flex flex-wrap flex-grow-1 gap-2">
            <!-- Поиск -->
            <div class="search-bar flex-grow-1 mb-0" style="min-width: 300px">
                <i class="bi bi-search text-muted me-3"></i>
                <input type="text" id="adminSearchInput" class="search-input" autofocus
                       placeholder="Название/артикул товара..." value="@Context.Request.Query["searchString"]" autocomplete="off" />
                <!-- Спиннер -->
                <div id="admin-spinner" class="spinner-border text-primary spinner-border-sm ms-2" role="status" style="display: none;">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Фильтры -->
            <select id="filterCategory" class="custom-select" asp-items="ViewBag.CategoryId">
                <option value="">Все категории</option>
            </select>

            <select id="filterSupplier" class="custom-select" asp-items="ViewBag.SupplierId">
                <option value="">Все поставщики</option>
            </select>

            <!-- Сортировка -->
            <select id="sortOrder" class="custom-select" style="min-width: 160px;">
                <option value="">Недавно добавленные</option>
                <option value="price_asc">Подешевле</option>
                <option value="price_desc">Подороже</option>
                <option value="qty_asc">С меньшим остатком</option>
                <option value="qty_desc">С большим остатком</option>
            </select>
        </div>

        <!-- Кнопка создания -->
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center px-4" style="height: 45px; border-radius: 100px;">
            <i class="bi bi-plus-lg me-2"></i>
            <span style="font-family: 'MTSans-Display'; white-space: nowrap">НОВЫЙ ТОВАР</span>
        </a>
    </div>

    <!-- Контейнер для таблицы -->
    <div id="products-table-container" style="flex-grow: 1; min-height: 0; display: flex; flex-direction: column;">
        <partial name="_ProductsTablePartial" />
    </div>

</div>

@section Scripts {
    <script>
        // Красивые выпадающие списки
        function initCustomSelects() {
            var x, i, j, l, ll, selElmnt, a, b, c;
            x = document.getElementsByClassName("custom-select");
            l = x.length;

            for (i = 0; i < l; i++) {
                selElmnt = x[i];

                if (selElmnt.nextElementSibling && selElmnt.nextElementSibling.classList.contains("select-wrapper")) continue;

                var wrapper = document.createElement("DIV");
                wrapper.setAttribute("class", "select-wrapper");
                selElmnt.parentNode.insertBefore(wrapper, selElmnt);
                wrapper.appendChild(selElmnt);

                a = document.createElement("DIV");
                a.setAttribute("class", "select-selected");
                a.innerHTML = selElmnt.options[selElmnt.selectedIndex].innerHTML;
                wrapper.appendChild(a);

                /* Контейнер для опций */
                b = document.createElement("DIV");
                b.setAttribute("class", "select-items");

                ll = selElmnt.length;
                for (j = 0; j < ll; j++) {
                    /* div для каждой опции */
                    c = document.createElement("DIV");
                    c.innerHTML = selElmnt.options[j].innerHTML;

                    // Подсветка активного элемента при загрузке
                    if (selElmnt.options[j].selected) {
                        c.setAttribute("class", "same-as-selected");
                    }

                    // Индекс оригинала
                    c.setAttribute("data-index", j);

                    c.addEventListener("click", function(e) {
                        /* При клике на кастомную опцию: */
                        var s = this.parentNode.parentNode.getElementsByTagName("select")[0];
                        var h = this.parentNode.previousSibling;

                        for (var i = 0; i < s.length; i++) {
                            if (s.options[i].innerHTML == this.innerHTML) {
                                s.selectedIndex = i;
                                h.innerHTML = this.innerHTML;

                                s.dispatchEvent(new Event('change'));

                                var y = this.parentNode.getElementsByClassName("same-as-selected");
                                for (var k = 0; k < y.length; k++) {
                                    y[k].removeAttribute("class");
                                }
                                this.setAttribute("class", "same-as-selected");
                                break;
                            }
                        }
                        h.click();
                    });
                    b.appendChild(c);
                }
                wrapper.appendChild(b);

                /* Открытие/закрытие по клику */
                a.addEventListener("click", function(e) {
                    e.stopPropagation();
                    closeAllSelect(this);
                    this.nextSibling.classList.toggle("select-show");
                    this.classList.toggle("select-arrow-active");
                });

                // Скрыть оригинальный селект
                selElmnt.style.display = "none";
            }
        }

        /* Функция закрытия всех списков при клике вне */
        function closeAllSelect(elmnt) {
            var x, y, i, xl, yl, arrNo = [];
            x = document.getElementsByClassName("select-items");
            y = document.getElementsByClassName("select-selected");
            xl = x.length;
            yl = y.length;
            for (i = 0; i < yl; i++) {
                if (elmnt == y[i]) {
                    arrNo.push(i)
                } else {
                    y[i].classList.remove("select-arrow-active");
                }
            }
            for (i = 0; i < xl; i++) {
                if (arrNo.indexOf(i)) {
                    x[i].classList.remove("select-show");
                }
            }
        }

        document.addEventListener("click", closeAllSelect);

        // Запускаем инициализацию
        document.addEventListener('DOMContentLoaded', function () {
            initCustomSelects();
        });

        // Для поиска
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('adminSearchInput');
            const filterCategory = document.getElementById('filterCategory');
            const filterSupplier = document.getElementById('filterSupplier');
            const sortOrder = document.getElementById('sortOrder');

            const tableContainer = document.getElementById('products-table-container');
            const spinner = document.getElementById('admin-spinner');

            let timeout = null;

            // Главная функция загрузки
            function loadData() {
                const query = searchInput.value;
                const cat = filterCategory.value;
                const sup = filterSupplier.value;
                const sort = sortOrder.value;

                spinner.style.display = 'block';

                // URL с параметрами
                const url = `@Url.Action("Search", "Products")?searchString=${encodeURIComponent(query)}&categoryId=${cat}&supplierId=${sup}&sortOrder=${sort}`;

                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        tableContainer.innerHTML = html;
                        spinner.style.display = 'none';
                    })
                    .catch(err => {
                        console.error(err);
                        spinner.style.display = 'none';
                    });
            }

            // Слушатель для поиска (с задержкой)
            searchInput.addEventListener('input', function () {
                clearTimeout(timeout);
                timeout = setTimeout(loadData, 300);
            });

            // Слушатели для фильтров (мгновенно)
            filterCategory.addEventListener('change', loadData);
            filterSupplier.addEventListener('change', loadData);
            sortOrder.addEventListener('change', loadData);

            loadData();
        });
    </script>
}