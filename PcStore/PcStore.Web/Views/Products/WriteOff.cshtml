@model PcStore.Web.Models.Product

@{
    ViewData["Title"] = "Списание товара";
}

<div class="admin-container scrollable">
    <div class="form-card" style="max-width: 600px">

        <!-- Заголовок с красным акцентом -->
        <h2 class="page-title text-center mb-4" style="justify-content: center; color: var(--danger)">Списание</h2>

        <!-- Информация о товаре -->
        <div class="text-center mb-4">
            <h4 class="text-white mb-1">@Model.Name</h4>
            <div class="small text-muted" style="font-family: 'MTSans-Condensed'">Артикул: @Model.Sku</div>
        </div>

        <!-- Красивое отображение текущего остатка -->
        <div class="p-3 mb-4 rounded bg-dark border border-secondary d-flex justify-content-between align-items-center">
            <span class="text-muted">Текущий остаток:</span>
            <!-- Если количество > 0, то цвет красный (опасно), иначе зелёный (готово к удалению) -->
            <span class="@(Model.QuantityInStock == 0 ? "text-danger fw-bold fs-4" : "text-success")">
                @Model.QuantityInStock шт.
            </span>
        </div>

        <form asp-action="WriteOff" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" name="id" value="@Model.Id" />

            <!-- Поле количества -->
            <div class="form-group">
                <label class="control-label">Количество для списания</label>
                <div class="input-group">
                    <!-- value возвращает то же значение, что было до отказа формы -->
                    <input type="number" name="quantity" class="form-control" id="qtyInput" min="1" max="@Model.QuantityInStock" required
                           style="font-family: 'MTSans-Display'; font-size: 1.2rem;" autofocus
                           value="@ViewBag.Quantity"
                           @(Model.QuantityInStock == 0 ? "disabled" : "") />
                    <span class="input-group-text bg-dark text-white border-secondary">шт.</span>
                </div>
                <div class="form-text text-muted small mt-1">Не более @Model.QuantityInStock</div>
            </div>

            <!-- Поле причины -->
            <div class="form-group">
                <label class="control-label">Причина (брак, утеря, порча, ...)</label>
                <textarea name="reason" class="form-control" id="rsnInput" rows="3" placeholder="Опишите причину списания..."
                          @(Model.QuantityInStock == 0 ? "disabled" : "")>@ViewBag.Reason</textarea>
            </div>

            <!-- Логика блокировки -->
            @if (Model.QuantityInStock == 0)
            {
                <!-- Блок предупреждения -->
                <div class="alert bg-dark border-danger d-flex align-items-start text-start mb-4" role="alert">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-3 me-3"></i>
                    <div>
                        <h5 class="text-danger fw-bold mb-1">Действие невозможно</h5>
                        <p class="mb-2 small text-muted">
                            Этот товар не числится на складе.
                            <br />Списать можно только товары, имеющиеся в наличии.
                        </p>
                        <p class="mb-0 small">
                            Пожалуйста, проведите <a asp-action="Supply" asp-route-id="@Model.Id" class="text-warning text-decoration-underline">процедуру оформления поставки</a>.
                        </p>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                    <!-- Кнопка отключена -->
                    <button class="btn btn-secondary px-4" disabled>Списать</button>
                </div>
            }
            else
            {
                <!-- Всё чисто, можно удалять -->
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                    <button type="submit" class="btn btn-danger px-4">Списать</button>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const qtyInput = document.getElementById('qtyInput');
            const rsnInput = document.getElementById('rsnInput');

            if (qtyInput && rsnInput) {

                // --- ЛОГИКА ФОКУСА ПРИ ЗАГРУЗКЕ ---
                // Если количество заполнено, а причина пустая (ситуация ошибки валидации)
                if (qtyInput.value && !rsnInput.value) {
                    // Курсор в причину
                    rsnInput.focus();
                }
                // Иначе сработает стандартный атрибут autofocus на поле количества


                // --- ЛОГИКА ПЕРЕХОДА ПО ENTER ---
                qtyInput.addEventListener('keydown', function(event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        if (qtyInput.value) {
                            rsnInput.focus();
                        }
                    }
                });
            }
        });
    </script>
}