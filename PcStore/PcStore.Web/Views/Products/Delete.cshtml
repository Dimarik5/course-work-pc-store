@model PcStore.Web.Models.Product

@{
    ViewData["Title"] = "Архивация товара";
    Layout = "_Layout";
}

<div class="admin-container scrollable">
    <div class="form-card text-center" style="border-color: var(--danger); box-shadow: 0 0 30px rgba(247, 90, 104, 0.1);">

        <div class="mb-4 text-danger">
            <i class="bi bi-archive-fill display-1"></i>
        </div>

        <h2 class="page-title text-center text-danger mb-3" style="justify-content: center;">АРХИВИРОВАТЬ ТОВАР?</h2>

        <p class="text-muted fs-5 mb-4">
            Вы собираетесь переместить товар
            <strong class="text-white">"@Model.Name"</strong> в&nbsp;архив.
            <br />Он будет скрыт из продажи, но останется в&nbsp;истории.
        </p>

        <!-- Карточка информации -->
        <div class="bg-dark p-3 rounded mb-4 text-start d-inline-block mx-auto" style="border: 1px solid var(--border); width: 100%">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted me-3">Артикул:</span>
                <span class="text-white text-end text-break">@Model.Sku</span>
            </div>

            <div class="d-flex justify-content-between mb-2 align-items-center">
                <span class="text-muted me-3">Остаток:</span>
                <!-- Если количество > 0, то цвет красный (опасно), иначе зелёный (готово к удалению) -->
                <span class="@(Model.QuantityInStock > 0 ? "text-danger fw-bold fs-5" : "text-success")">
                    @Model.QuantityInStock шт.
                </span>
            </div>

            <div class="d-flex justify-content-between">
                <span class="text-muted">Цена:</span>
                <span class="text-white">@Model.Price.ToString("C")</span>
            </div>
        </div>

        <!-- Логика блокировки -->
        @if (Model.QuantityInStock > 0)
        {
            <!-- Блок предупреждения -->
            <div class="alert bg-dark border-danger d-flex align-items-start text-start mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill text-danger fs-3 me-3"></i>
                <div>
                    <h5 class="text-danger fw-bold mb-1">Действие невозможно</h5>
                    <p class="mb-2 small text-muted">
                        Этот товар числится на складе.
                        <br />Архивировать можно только товары, не имеющиеся в наличии.
                    </p>
                    <p class="mb-0 small">
                        Пожалуйста, проведите <a asp-action="WriteOff" asp-route-id="@Model.Id" class="text-warning text-decoration-underline">процедуру оформления списания</a>
                        или оформите <a asp-controller="Sales" asp-action="Index" class="text-warning text-decoration-underline">продажу</a> остатков.
                    </p>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Назад</a>
                <!-- Кнопка отключена -->
                <button class="btn btn-secondary px-4" disabled>Архивировать</button>
            </div>
        }
        else
        {
            <!-- Всё чисто, можно удалять -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                    <input type="submit" value="Архивировать" class="btn btn-danger px-4" />
                </div>
            </form>
        }
    </div>
</div>