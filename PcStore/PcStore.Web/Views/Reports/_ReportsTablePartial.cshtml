@model IEnumerable<PcStore.Web.Models.Sale>

<div class="table-card">
    <div class="table-responsive-custom">
        @if (!Model.Any())
        {
            <div class="text-center text-muted w-100 mt-5 mb-5">
                <i class="bi bi-calendar-x display-1"></i>
                <p class="mt-3">За выбранный период продаж не найдено</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="text-start" style="width: 15%">ДАТА / ВРЕМЯ</th>
                        <th style="width: 40%">ПРОДАВЕЦ</th>
                        <th class="text-end" style="width: 25%">СУММА</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-start">
                                <div class="text-white">@item.DateTime.ToShortDateString()</div>
                                <div class="small text-muted" style="font-family: 'MTSans-Condensed';">@item.DateTime.ToShortTimeString()</div>
                            </td>
                            <td>
                                <div class="text-white">@item.User?.FullName</div>
                                <div class="small text-muted">@item.User?.Role?.Name</div>
                            </td>
                            <td class="text-end" style="font-family: 'MTSans-Display'; color: var(--accent); font-size: 1.2rem;">
                                @item.TotalAmount.ToString("N2") ₽
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>