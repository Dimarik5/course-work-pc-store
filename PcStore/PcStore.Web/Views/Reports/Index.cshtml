@model PcStore.Web.Models.SaleReport

@{
    ViewData["Title"] = "Отчеты";
}

<div class="admin-container">

    <!-- Заголовок -->
    <h1 class="page-title">
        <i class="bi bi-graph-up text-primary"></i> Финансовый отчет
    </h1>

    <!-- Панель выбора даты и генерации PDF -->
    <div class="toolbar mb-4">
        <form id="reportForm" asp-action="ExportPdf" method="get" class="d-flex flex-wrap gap-3 align-items-end w-100">

            <div style="flex: 1;">
                <label class="small text-muted mb-1">С даты</label>
                <!-- type="text" и класс datepicker -->
                <input type="text" id="startDate" name="startDate" class="form-control bg-dark text-white border-secondary datepicker"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div style="flex: 1;">
                <label class="small text-muted mb-1">По дату</label>
                <!-- type="text" и класс datepicker -->
                <input type="text" id="endDate" name="endDate" class="form-control bg-dark text-white border-secondary datepicker"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>

            <!-- Кнопка PDF -->
            <button type="submit" class="btn btn-outline-danger d-flex align-items-center gap-2" style="height: 38px;">
                <i class="bi bi-file-earmark-pdf-fill"></i>
                <span>ЭКСПОРТ В PDF</span>
            </button>

        </form>
    </div>

    <!-- Карточки итогов -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-4 rounded h-100 d-flex flex-column justify-content-between"
                 style="background-color: #151518; border: 1px solid var(--border);">
                <div class="text-muted small mb-1 text-uppercase">Выручка за период</div>
                <div class="text-success fw-bold" style="font-family: 'MTSans-Display'; font-size: 2.5rem; line-height: 1;" id="totalRevenue">
                    @Model.TotalRevenue.ToString("N2") ₽
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-4 rounded h-100 d-flex flex-column justify-content-between"
                 style="background-color: #151518; border: 1px solid var(--border);">
                <div class="text-muted small mb-1 text-uppercase">Количество продаж</div>
                <div class="text-white fw-bold" style="font-family: 'MTSans-Display'; font-size: 2.5rem; line-height: 1;" id="salesCount">
                    @Model.SalesCount
                </div>
            </div>
        </div>
    </div>

    <!-- Таблица -->
    <div id="report-table-container" style="flex-grow: 1; min-height: 0; display: flex; flex-direction: column;">
        <partial name="_ReportsTablePartial" model="Model.Sales" />
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Инициализация красивого календаря ---
            flatpickr(".datepicker", {
                "locale": "ru", // Русский язык
                dateFormat: "Y-m-d", // Формат, который понимает C#
                allowInput: true, // Можно вводить руками
                disableMobile: "true" // На мобилках тоже наш календарь, а не нативный
            });

            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');
            const tableContainer = document.getElementById('report-table-container');

            const totalRevenueEl = document.getElementById('totalRevenue');
            const salesCountEl = document.getElementById('salesCount');

            function loadReportData() {
                const start = startDateInput.value;
                const end = endDateInput.value;
                
                window.location.href = `@Url.Action("Index", "Reports")?startDate=${start}&endDate=${end}`;
            }
            
            startDateInput.addEventListener('change', loadReportData);
            endDateInput.addEventListener('change', loadReportData);
        });
    </script>
}