@model IEnumerable<PcStore.Web.Models.Category>

@{
    <div class="categories-grid">
        @if (!Model.Any())
        {
            <div class="text-center text-muted w-100 mt-5">
                <i class="bi bi-search display-1"></i>
                <p class="mt-3">Ничего не найдено</p>
            </div>
        }
        else
        {
            @foreach (var category in Model)
            {
                <div class="category-card">
                    <div>
                        <div class="category-title">@category.Name</div>
                        <div class="category-desc">
                            @(string.IsNullOrEmpty(category.Description) ? "--- ОПИСАНИЕ ОТСУТСТВУЕТ ---" : category.Description)
                        </div>
                    </div>

                    <div class="dict-actions">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="action-btn" title="Редактировать"><i class="bi bi-pencil-fill"></i></a>
                        <a asp-action="Details" asp-route-id="@category.Id" class="action-btn" title="Подробнее"><i class="bi bi-eye-fill"></i></a>
                        <a asp-action="Delete" asp-route-id="@category.Id" class="action-btn danger" title="В архив"><i class="bi bi-archive-fill"></i></a>
                    </div>
                </div>
            }
        }
    </div>
}