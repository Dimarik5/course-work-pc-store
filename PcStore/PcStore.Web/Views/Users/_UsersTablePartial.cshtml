@model IEnumerable<PcStore.Web.Models.User>

<div class="table-card">
    <div class="table-responsive-custom">
        @if (!Model.Any())
        {
            <div class="text-center text-muted w-100 mt-5">
                <i class="bi bi-search display-1"></i>
                <p class="mt-3">Ничего не найдено</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width: 35%">СОТРУДНИК</th>
                        <th class="text-center" style="width: 20%">РОЛЬ</th>
                        <th class="text-center" style="width: 20%">СТАТУС</th>
                        <th class="text-end" style="width: 25%">ДЕЙСТВИЯ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Подсветка заблокированных серым
                        <tr class="@(item.IsBlocked ? "opacity-50" : "")">
                            <td>
                                <div class="d-flex align-items-center">
                                    <!-- Иконка человечка -->
                                    <div class="rounded-circle bg-dark d-flex align-items-center justify-content-center me-3"
                                         style="width: 40px; height: 40px; border: 1px solid var(--border);">
                                        <i class="bi bi-person-fill text-muted"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white">@item.FullName</div>
                                        <div class="small text-muted" style="font-family: 'MTSans-Condensed'">@item.Login</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="card-badge">@item.Role.Name</span>
                            </td>
                            <td class="text-center">
                                @if (item.IsBlocked)
                                {
                                    <span class="badge bg-danger text-dark">ЗАБЛОКИРОВАН</span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-dark">АКТИВЕН</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn" title="Редактировать"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="Подробнее"><i class="bi bi-eye-fill"></i></a>

                                    @if (!item.IsBlocked)
                                    {
                                        <!-- Кнопка блокировки -->
                                        <div style="width: 1px; background: var(--border); border-radius: 8px; margin: 0 5px;"></div>

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn danger" title="Заблокировать">
                                            <i class="bi bi-shield-lock-fill"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>