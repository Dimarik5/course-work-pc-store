@model PcStore.Web.Models.User

@{
    ViewData["Title"] = "Редактирование";
}

<div class="admin-container scrollable">
    <div class="form-card">
        <h2 class="page-title text-center mb-4" style="justify-content: center">РЕДАКТИРОВАНИЕ</h2>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />


            <div class="row">

                <div class="col-md-6 form-group">
                    <label asp-for="FullName" class="control-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="ФИО сотрудника полностью..." />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="RoleId" class="control-label"></label>
                    <select asp-for="RoleId" class="form-control" asp-items="ViewBag.RoleId"></select>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6 form-group">
                    <label asp-for="Login" class="control-label"></label>
                    <input asp-for="Login" class="form-control" placeholder="Логин пользователя..." />
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Пароль пользователя..." />

                        <!-- Кнопка показа пароля -->
                        <button type="button" class="btn btn-outline-secondary" id="togglePasswordBtn"
                                style="border-color: var(--border); color: var(--text-muted);">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                <button type="submit" class="btn btn-primary px-4">Сохранить</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');

            toggleBtn.addEventListener('click', function () {
                // Проверка текущего типа
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);

                // Смена иконки
                if (type === 'text') {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                    toggleBtn.style.color = "var(--accent)";
                } else {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                    toggleBtn.style.color = "var(--text-muted)";
                }
            });
        });
    </script>
}