@model PcStore.Web.Models.User

@{
    ViewData["Title"] = Model.FullName;
}

<div class="admin-container scrollable">
    <!-- Центрируем карточку -->
    <div class="form-card" style="max-width: 800px; margin: auto;">

        <!-- Заголовок -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2 class="page-title m-0" style="margin-bottom: 0;">ПРОФИЛЬ СОТРУДНИКА</h2>
            <div class="text-muted small" style="white-space: nowrap;">ID: @Model.Id</div>
        </div>

        <!-- Основная информация -->
        <div class="profile-card">

            <!-- Иконка профиля -->
            <div class="profile-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <!-- Имя и роль -->
            <div>
                <div class="profile-role">@Model.Role.Name</div>
                <h1 class="profile-name">@Model.FullName</h1>

                <div class="mt-3">
                    @if (Model.IsBlocked)
                    {
                        <span class="badge bg-danger text-dark px-3 py-2">ДОСТУП ЗАПРЕЩЕН</span>
                    }
                    else
                    {
                        <span class="badge bg-success text-dark px-3 py-2">ДОСТУП РАЗРЕШЕН</span>
                    }
                </div>
            </div>
        </div>

        <!-- Логин и пароль -->
        <div class="tech-data-box">
            <div>
                <div class="data-label">Логин (System Login)</div>
                <div class="data-value">@Model.Login</div>
            </div>
            <div>
                <div class="data-label">Пароль</div>
                <div class="data-value text-muted" style="letter-spacing: 3px;">••••••••</div>
            </div>
        </div>

        <!-- Кнопки действий -->
        <div class="d-flex justify-content-between align-items-center mt-5">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i> Назад к персоналу
            </a>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                    <i class="bi bi-pencil-fill me-2"></i> Редактировать
                </a>
            </div>
        </div>

    </div>
</div>