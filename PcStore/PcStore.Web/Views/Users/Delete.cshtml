@model PcStore.Web.Models.User

@{
    ViewData["Title"] = "Блокировка пользователя";
}

<div class="admin-container scrollable">
    <div class="form-card text-center" style="border-color: var(--danger); box-shadow: 0 0 30px rgba(247, 90, 104, 0.1);">

        <div class="mb-4 text-danger">
            <i class="bi bi-shield-lock-fill display-1"></i>
        </div>

        <h2 class="page-title text-center text-danger mb-3" style="justify-content: center;">ЗАБЛОКИРОВАТЬ ПОЛЬЗОВАТЕЛЯ?</h2>

        <p class="text-muted fs-5 mb-4">
            Вы собираетесь заблокировать пользователя
            <strong class="text-white">"@Model.FullName"</strong>.
            <br />Пользователь потеряет доступ к сервису, но останется в&nbsp;истории.
        </p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                <input type="submit" value="Архивировать" class="btn btn-danger px-4" />
            </div>
        </form>
    </div>
</div>