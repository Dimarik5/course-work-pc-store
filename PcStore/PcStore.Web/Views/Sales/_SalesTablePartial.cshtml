@using PcStore.Web.Models
@model IEnumerable<PcStore.Web.Models.Sale>

<!-- Контейнер для таблицы -->
<div class="table-card" style="flex-grow: 1; min-height: 0; display: flex; flex-direction: column;">
    <div class="table-responsive-custom">
        @if (!Model.Any())
        {
            <div class="text-center text-muted w-100 mt-5">
                <i class="bi bi-search display-1"></i>
                <p class="mt-3">Ничего не найдено</p>
            </div>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="width: 8%">№ ЧЕКА</th>
                        <th class="text-center" style="width: 12%">ДАТА / ВРЕМЯ</th>
                        <th style="width: 20%">ПРОДАВЕЦ</th>
                        <th class="text-center" style="width: 20%">СКИДКА</th>
                        <th class="text-center" style="width: 20%">ИТОГО</th>
                        <th class="text-center" style="width: 5%">СТАТУС</th>
                        <th class="text-end" style="width: 10%">ДЕЙСТВИЯ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Расчеты скидки
                        decimal originalSum = item.SaleItems.Sum(x => x.PriceAtSale * x.Quantity);
                        decimal discount = originalSum - item.TotalAmount;

                        <tr>
                            <td class="text-white fw-bold">#@item.Id</td>
                            <td class="text-center">
                                <div class="text-white">@item.DateTime.ToShortDateString()</div>
                                <div class="small text-muted" style="font-family: 'MTSans-Condensed';">@item.DateTime.ToShortTimeString()</div>
                            </td>
                            <td>
                                <div class="text-white">@item.User?.FullName</div>
                                <div class="small text-muted">@item.User?.Role?.Name</div>
                            </td>
                            <td class="text-center">
                                @if (discount > 0.00m)
                                {
                                    int percent = (int)Math.Round((discount / originalSum) * 100);
                                    <span class="card-badge" style="color: var(--success); border-color: var(--success);">
                                        -@discount.ToString("N0") ₽ (@percent%)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center" style="font-family: 'MTSans-Display'; color: var(--accent); font-size: 1.1rem;">
                                @item.TotalAmount.ToString("N2") ₽
                            </td>
                            <td class="text-center">
                                @switch (item.Status)
                                {
                                    case SaleStatus.Draft:
                                        <span class="badge bg-warning text-dark">Черновик</span>
                                        break;
                                    case SaleStatus.WaitingForPayment:
                                        <span class="badge bg-warning text-dark">Ожидает оплаты</span>
                                        break;
                                    case SaleStatus.Paid:
                                        <span class="badge bg-success">Оплачен</span>
                                        break;
                                    case SaleStatus.CancelledBySeller:
                                        <span class="badge bg-danger">Отменен продавцом</span>
                                        break;
                                    case SaleStatus.CancelledBySystem:
                                        <span class="badge bg-danger">Истек срок оплаты</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">Неизвестно</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="Детали чека"><i class="bi bi-eye-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>