@model IEnumerable<PcStore.Web.Models.Sale>

@{
    ViewData["Title"] = "История продаж";
}

<h2>История продаж</h2>

<table class="table table-hover">
    <thead>
        <tr>
            <th>№ Чека</th>
            <th>Дата</th>
            <th>Продавец</th>
            <th>Сумма</th>
            <th>Скидка</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            // Расчёт реальной стоимости товаров (без скидки)
            decimal originalSum = item.SaleItems.Sum(x => x.PriceAtSale * x.Quantity);

            // Расчёт разницы (размер скидки)
            decimal discount = originalSum - item.TotalAmount;

            <tr>
                <td>@item.Id</td>
                <td>
                    @item.DateTime.ToShortDateString()
                    <small class="text-muted">@item.DateTime.ToShortTimeString()</small>
                </td>
                <td>@item.User?.FullName</td>
                <td class="fw-bold text-primary">@item.TotalAmount.ToString("C")</td>

                <td>
                    @if (discount > 0.00m) // Если скидка больше 0.00 руб.
                    {
                        // Вычисление процента
                        int percent = (int)Math.Round((discount / originalSum) * 100);

                        <span class="badge bg-success">
                            -@discount.ToString("C") (@percent%)
                        </span>
                        <br />
                        <small class="text-muted text-decoration-line-through">
                            @originalSum.ToString("C")
                        </small>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>