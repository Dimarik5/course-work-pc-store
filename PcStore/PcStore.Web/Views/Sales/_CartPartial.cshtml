@{
    var cart = ViewBag.Cart as List<PcStore.Web.Models.CartItem>;
    var cartTotal = (decimal)(ViewBag.GrandTotal ?? 0);
    var lastId = ViewBag.LastChangedId as int?;
}

<aside class="pos-cart">
    <h2 style="font-family: 'MTSans-Extended', sans-serif; margin-bottom: 20px;">
        <i class="bi bi-receipt"></i> ТЕКУЩИЙ ЧЕК
    </h2>

    <div class="cart-items">
        @if (cart != null && cart.Any())
        {
            @foreach (var item in cart)
            {
                var animationClass = (item.ProductId == lastId) ? "slide-in" : "";

                <div class="cart-item @animationClass">
                    <div style="overflow: hidden; margin-right: 10px;">
                        <div style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @item.ProductName
                        </div>
                        <div class="small text-muted">@item.Quantity x @item.Price.ToString("N2")</div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span style="font-weight: 700; margin-right: 10px;">@item.Total.ToString("N2")</span>

                        <!-- Кнопка удаления -->
                        <form form asp-controller="Sales" asp-action="RemoveFromCart" method="post" class="ajax-form">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm text-danger" style="background: none; border: none;">✕</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; color: var(--text-sec); margin-top: 50px;">
                <i class="bi bi-basket" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3">Корзина пуста</p>
            </div>
        }
    </div>

    <!-- Нижняя панель чека -->
    <div class="cart-total-panel">
        <div class="d-flex justify-content-between text-muted mb-2">
            <span>Сумма:</span>
            <span>@(((decimal)(ViewBag.SubTotal ?? 0)).ToString("C"))</span>
        </div>

        @if (ViewBag.DiscountAmount > 0)
        {
            <div class="d-flex justify-content-between text-success mb-2">
                <span>Скидка (@(ViewBag.DiscountPercent)%):</span>
                <span>-@(((decimal)ViewBag.DiscountAmount).ToString("C"))</span>
            </div>
        }

        <!-- Форма промокода -->
        <form asp-controller="Sales" asp-action="ApplyDiscount" method="post" class="ajax-form" style="display: flex; gap: 10px; margin-bottom: 15px;">
            <input type="text" name="code" placeholder="PROMO"
                   style="background: #222; border: 1px solid var(--border); color: white; padding: 8px; border-radius: 8px; width: 100%;">
        </form>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span style="font-size: 1.2rem;">ИТОГО:</span>
            <div class="total-price">@cartTotal.ToString("N2") <span style="font-size: 1rem; color: var(--text-sec);">₽</span></div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 3fr; gap: 10px;">
            <!-- Сброс -->
            <form asp-controller="Sales" asp-action="ClearCart" method="post" class="ajax-form h-100">
                <button class="btn" style="width: 100%; height: 100%; background: #333; color: var(--text-muted); border-radius: 12px;">
                    <i class="bi bi-trash"></i>
                </button>
            </form>

            <!-- Оплата -->
            <form asp-controller="Sales" asp-action="FinalizeSale" method="post">
                <button class="btn-checkout">ОФОРМИТЬ ПРОДАЖУ</button>
            </form>
        </div>
    </div>
</aside>