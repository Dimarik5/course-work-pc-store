@model PcStore.Web.Models.Sale

<aside class="pos-cart">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0" style="font-family: 'MTSans-Extended', sans-serif; letter-spacing: 1px;">
            <i class="bi bi-receipt"></i> ЧЕК
            @if (Model != null)
            {
                <span class="text-muted small ms-2">#@Model.Id</span>
            }
        </h2>
    </div>

    <div class="cart-items">
        @if (Model != null && Model.SaleItems != null && Model.SaleItems.Any())
        {
            @foreach (var item in Model.SaleItems)
            {
                <div class="cart-item @(ViewBag.LastChangedId == item.ProductId ? "slide-in" : "")">
                    <div style="overflow: hidden; margin-right: 10px;">
                        <div style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @item.Product.Name
                        </div>
                        <div class="small text-muted">@item.Quantity x @item.PriceAtSale.ToString("N2")</div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span style="font-weight: 700; margin-right: 10px;">
                            @((item.Quantity * item.PriceAtSale).ToString("N2"))
                        </span>

                        <!-- Удаление -->
                        <form asp-controller="Sales" asp-action="RemoveItem" method="post" class="ajax-form">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="saleId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm text-danger" style="background: none; border: none;">✕</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; color: var(--text-sec); margin-top: 50px;">
                <i class="bi bi-basket" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3">
                    @(Model == null ? "Нет активного чека" : "Чек пуст")
                </p>
                @if (Model == null)
                {
                    <form asp-action="CreateNewSale" method="post">
                        <button class="btn btn-outline-primary mt-2">Создать новый</button>
                    </form>
                }
            </div>
        }
    </div>

    <!-- Нижняя панель -->
    @if (Model != null)
    {
        <div class="cart-total-panel">
            <div class="d-flex justify-content-between text-muted mb-2">
                <span>Сумма:</span>
                <span>@(((decimal)(ViewBag.SubTotal ?? 0)).ToString("N2")) ₽</span>
            </div>

            @if (ViewBag.DiscountAmount > 0)
            {
                <div class="d-flex justify-content-between text-success mb-2">
                    <span>Скидка (@(ViewBag.DiscountPercent)%):</span>
                    <span>-@(((decimal)ViewBag.DiscountAmount).ToString("N2")) ₽</span>
                </div>
            }

            <!-- Промокод -->
            <form asp-controller="Sales" asp-action="ApplyDiscount" method="post" class="ajax-form" style="display: flex; gap: 10px; margin-bottom: 15px;">
                <input type="hidden" name="saleId" value="@Model.Id" />
                <input type="text" name="code" placeholder="PROMO"
                       style="background: #222; border: 1px solid var(--border); color: white; padding: 8px; border-radius: 8px; width: 100%;">
            </form>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span style="font-size: 1.2rem;">ИТОГО:</span>
                <div class="total-price">
                    @(((decimal)(ViewBag.GrandTotal ?? 0)).ToString("N2"))
                    <span style="font-size: 1rem; color: var(--text-sec);">RUB</span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 3fr; gap: 10px;">
                <!-- Отмена продавцом -->
                <form asp-controller="Sales" asp-action="CancelSale" method="post" class="h-100">
                    <input type="hidden" name="saleId" value="@Model.Id" />
                    <button class="btn" style="width: 100%; height: 100%; background: #333; color: var(--danger); border-radius: 12px;">
                        <i class="bi bi-trash" style="font-size: 1.5rem;"></i>
                    </button>
                </form>

                <!-- Оплата -->
                <form asp-action="FinalizeSale" method="post">
                    <input type="hidden" name="saleId" value="@Model.Id" />
                    <button class="btn-checkout" @(Model.SaleItems.Any() ? "" : "disabled")>ОФОРМИТЬ ПРОДАЖУ</button>
                </form>
            </div>
        </div>
    }
</aside>