@model IEnumerable<PcStore.Web.Models.Product>
@{
    ViewData["Title"] = "Терминал продажи";
    var cart = ViewBag.Cart as List<PcStore.Web.Models.CartItem>;
}

<div class="container-fluid">
    <div class="row">
        <!-- Слева: каталог товаров -->
        <div class="col-md-8">
            <h3>Каталог товаров</h3>

            <form asp-action="Index" method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Поиск по названию или артикулу..." />
                    <button type="submit" class="btn btn-outline-primary">Найти</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Сброс</a>
                </div>
            </form>

            <div class="row">
                @foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted small">@product.Category?.Name | Остаток: @product.QuantityInStock</p>
                                <h4 class="text-primary">@product.Price.ToString("C")</h4> <!-- "C" меняет формат отображения цены и валюту в зависимости от языка пользователя -->
                                <!-- Форма добавления в "корзину" -->
                                <form asp-action="AddToCart" method="post" class="mt-3">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <div class="input-group">
                                        <input type="number" name="quantity" class="form-control" value="1" min="1" max="@product.QuantityInStock" />
                                        <button type="submit" class="btn btn-success">В чек +</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Справа: текущий чек -->
        <div class="col-md-4">
            <div class="card border-primary mb-3" style="position: sticky; top: 20px;">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Текущий чек</h4>
                </div>
                <div class="card-body">
                    @if (cart != null && cart.Any())
                    {
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Товар</th>
                                    <th>Количество</th>
                                    <th>Сумма</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cart)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Total.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <hr />

                        <!-- Блок итогов -->
                        <div class="d-flex justify-content-between">
                            <span>Подытог:</span>
                            <span class="fw-bold">@(((decimal)ViewBag.SubTotal).ToString("C"))</span>
                        </div>

                        @if (ViewBag.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between text-success">
                                <span>Скидка (@ViewBag.DiscountPercent%):</span>
                                <span class="fw-bold">-@(((decimal)ViewBag.DiscountAmount).ToString("C"))</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-2">
                            <h3>ИТОГО:</h3>
                            <h3 class="text-primary">@(((decimal)ViewBag.GrandTotal).ToString("C"))</h3>
                        </div>

                        <!-- Форма скидки -->
                        <form asp-action="ApplyDiscount" method="post" class="input-group my-3">
                            <input type="text" name="code" class="form-control" placeholder="Промокод (PROMO10, STUDENT, VIP)" />
                            <button type="submit" class="btn btn-outline-secondary">Применить</button>
                        </form>

                        <div class="d-grid gap-2 mt-3">
                            <form asp-action="FinalizeSale" method="post">
                                <button type="submit" class="btn btn-lg btn-primary w-100">Оформить продажу</button>
                            </form>

                            <form asp-action="ClearCart" method="post">
                                <button type="submit" class="btn btn-outline-danger w-100">Сбросить чек</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted my-3">Чек пуст. Добавьте товары слева.</p>
                    }
                </div>
            </div>
        </div>
