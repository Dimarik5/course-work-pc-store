@model PcStore.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Вход";
    Layout = "_EmptyLayout";
}

<div class="auth-overlay">

    <!-- Логотип -->
    <div class="auth-logo">
        PC<span>S</span>
    </div>

    <!-- Карточка -->
    <div class="auth-card">
        <div class="auth-header">
            <i class="bi bi-box-arrow-in-right auth-icon"></i>
            <h2>ВХОД</h2>
        </div>

        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <!-- Логин -->
            <div class="input-icon-group">
                <input asp-for="Login" class="form-control" placeholder="Логин" autocomplete="off" autofocus />
                <i class="bi bi-person-fill"></i>
            </div>

            <!-- Пароль -->
            <div class="input-icon-group">
                <input asp-for="Password" class="form-control" type="password" placeholder="Пароль" />
                <i class="bi bi-lock-fill"></i>
            </div>

            <button type="submit" class="btn btn-primary btn-auth">ВОЙТИ В СИСТЕМУ</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}