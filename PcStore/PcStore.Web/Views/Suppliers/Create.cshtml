@model PcStore.Web.Models.Supplier

@{
    ViewData["Title"] = "Добавление поставщика";
}

<div class="admin-container scrollable">
    <div class="form-card">
        <h2 class="page-title text-center mb-4" style="justify-content: center">НОВЫЙ ПОСТАВЩИК</h2>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-12 form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Название поставщика..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ContactInfo" class="control-label"></label>
                <textarea asp-for="ContactInfo" class="form-control" placeholder="E-mail поставщика..."></textarea>
                <span asp-validation-for="ContactInfo" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                <button type="submit" class="btn btn-primary px-4">Создать</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}