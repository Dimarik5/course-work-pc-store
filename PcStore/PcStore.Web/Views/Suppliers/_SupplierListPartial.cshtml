@model IEnumerable<PcStore.Web.Models.Supplier>

@{
    <div class="suppliers-grid">
        @if (!Model.Any())
        {
            <div class="text-center text-muted w-100 mt-5">
                <i class="bi bi-search display-1"></i>
                <p class="mt-3">Ничего не найдено</p>
            </div>
        }
        else
        {
            @foreach (var supplier in Model)
            {
                <div class="supplier-card">
                    <div>
                        <div class="supplier-title">@supplier.Name</div>
                        <div class="supplier-desc">@supplier.ContactInfo</div>
                    </div>

                    <div class="dict-actions">
                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="action-btn" title="Редактировать"><i class="bi bi-pencil-fill"></i></a>
                        <a asp-action="Details" asp-route-id="@supplier.Id" class="action-btn" title="Подробнее"><i class="bi bi-eye-fill"></i></a>

                        @if (User.IsInRole("Менеджер"))
                        {
                            <a asp-action="Delete" asp-route-id="@supplier.Id" class="action-btn danger" title="В архив"><i class="bi bi-archive-fill"></i></a>
                        }
                    </div>
                </div>
            }
        }
    </div>
}